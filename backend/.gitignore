#   esbuild/tsx 产不出 —— 详见 scripts/run-tests.mjs 文件头）。
.tmp_test_build/

# ★ 环境变量：真实值绝不入库（.env.example 才是模板）
.env
.env.*
!.env.example

# 日志
npm-install.log
*.log
