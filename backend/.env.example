# ══════════════════════════════════════════════════════════════════
#  kids_points_api  环境变量模板
#  用法：cp .env.example .env  然后填入真实值
#  ⚠ 本文件只放「键 + 说明」，真实值绝不入库（见 .gitignore）
# ══════════════════════════════════════════════════════════════════

# ── 数据库（L1 已于 2026-10-12 解除：PostgreSQL 18.6，见 06 §6 / §10）──────
# ★ 两条连接串分工（决策 D7）—— 这是 I5「账本不可改」成立的前提，**不可合并成一条**：
#   ① 应用角色：只有 CRUD；且 PointRecord / PointRuleVersion / AuditLog 已被
#      REVOKE UPDATE, DELETE（02 §5.7 I5）。角色由 prisma/sql/900_ledger_revoke.sql 创建，
#      **口令由 prisma/sql/901_set_app_password.sql 在部署时注入**（阶段 B2）。
#      ⇒ 下行的 `REPLACE_ME_BY_DEPLOY` 是**占位符**，永远不会被任何脚本当成真口令使用；
#        本文件（以及整个仓库）**不得出现任何真实口令**。
DATABASE_URL="postgresql://kids_points_app:REPLACE_ME_BY_DEPLOY@localhost:5432/kids_points?schema=public"
#   ② 表所有者：需要 DDL 权限建表 / GRANT / REVOKE。仅 CLI 迁移与授权使用，**应用不得使用**。
MIGRATION_DATABASE_URL="postgresql://postgres:填你的口令@localhost:5432/kids_points?schema=public"
#   ⚠ 迁移链（顺序不能错；**每条 psql 都必须带 -v ON_ERROR_STOP=1**）：
#     npx prisma migrate dev --name <name>      # 建表（所有者）
#     npm run seed                             # 18 条模板；Prisma 7 的 migrate dev **不会**自动跑（缺陷 11）
#     psql "$MIGRATION_DATABASE_URL" -v ON_ERROR_STOP=1 -f prisma/sql/900_ledger_revoke.sql
#     APP_DB_PASSWORD='<强口令>' psql "$MIGRATION_DATABASE_URL" -v ON_ERROR_STOP=1 \
#       -v app_password="$APP_DB_PASSWORD" -f prisma/sql/901_set_app_password.sql
#     npm run db:verify                        # I5 + 口令判据 P1–P3 实证（可失败）
#   `migrate reset` 之后必须重跑后三步（§10.3）。
#   ★ 为什么每条都要 `-v ON_ERROR_STOP=1`（2026-10-14 在 psql 18.6 上实测，非推断）：
#     脚本内的 RAISE EXCEPTION 在**不带**它时，psql 退出码仍然是 **0** ——
#     检查"执行了"，但脚本调用者与 CI 全都看不见它失败（D12 假绿的同一形状）。

NODE_ENV=development
PORT=3000

# ── L2 阻塞项：微信小程序（主体认证 1–7 工作日后才有正式值）────────
WECHAT_MP_APPID="touristappid"   # ← 游客态，见 kids_points_mp/project.config.json
WECHAT_MP_SECRET=""

# ── L4 阻塞项：域名（微信强制 HTTPS + 域名白名单，依赖备案）────────
PUBLIC_BASE_URL=""

# ── 业务参数（02 §6 / §4.3 / §7 已定稿，此处仅为可配置化留口）──────
DEVICE_SESSION_TTL_MINUTES=5      # 02 §7：5 分钟无操作回落 child
PIN_MAX_ATTEMPTS=5                # 02 §7：连错 5 次
PIN_LOCK_MINUTES=15               # 02 §7：锁定 15 分钟
CHILD_DAILY_BONUS_REQUEST_LIMIT=3 # 02 §6：Q13 = 3 条/天
CHILD_BONUS_AMOUNT_LIMIT=50       # 02 §6：Q15 = 单笔 ±50
APPROVAL_TTL_HOURS=72             # 02 §4.3：审批 TTL 默认 72h
APPROVAL_EXPIRY_SCAN_INTERVAL_MS=60000 # W3-C：过期扫描周期（默认 60s；0/非法 ⇒ 默认）
RECYCLE_BIN_RETENTION_DAYS=90     # 03 C9：Q12 = 配置 90 天可恢复（账本永不删）

# ── 推送网关（W6-A，2026-10-24；见 docs/design/29-w6a-handoff.md）────────────
# ★ 不配 ⇒ PUSH_PORT 绑 NoopPushAdapter，推送如实返回 provider_not_configured（**不是故障**）。
# ★ 配错（非法 URL / 非 http(s) / 生产用 http）⇒ 仍是 no-op，但启动日志打 **error** —— 
#   否则「我明明配了」与「一条都没发」会长期共存而没人知道。
PUSH_WEBHOOK_URL=""               # 例：https://push-gateway.example.com/push（生产必须 https：请求体含设备 token）
PUSH_WEBHOOK_TOKEN=""             # 可选；非空 ⇒ 带 authorization: Bearer <token>
PUSH_WEBHOOK_TIMEOUT_MS=800       # 默认 800；夹在 [100, 5000]，且必须 < NotificationsService 的 1000ms 兜底

