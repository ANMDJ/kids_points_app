# ══════════════════════════════════════════════════════════════════
#  kids_points_api  环境变量模板
#  用法：cp .env.example .env  然后填入真实值
#  ⚠ 本文件只放「键 + 说明」，真实值绝不入库（见 .gitignore）
# ══════════════════════════════════════════════════════════════════

# ── 数据库（L1 已于 2026-10-12 解除：PostgreSQL 18.6，见 06 §6 / §10）──────
# ★ 两条连接串分工（决策 D7）—— 这是 I5「账本不可改」成立的前提，**不可合并成一条**：
#   ① 应用角色：只有 CRUD；且 PointRecord / PointRuleVersion / AuditLog 已被
#      REVOKE UPDATE, DELETE（02 §5.7 I5）。角色由 prisma/sql/900_ledger_revoke.sql 创建，
#      **口令由 prisma/sql/901_set_app_password.sql 在部署时注入**（阶段 B2）。
#      ⇒ 下行的 `REPLACE_ME_BY_DEPLOY` 是**占位符**，永远不会被任何脚本当成真口令使用；
#        本文件（以及整个仓库）**不得出现任何真实口令**。
DATABASE_URL="postgresql://kids_points_app:REPLACE_ME_BY_DEPLOY@localhost:5432/kids_points?schema=public"
#   ② 表所有者：需要 DDL 权限建表 / GRANT / REVOKE。仅 CLI 迁移与授权使用，**应用不得使用**。
MIGRATION_DATABASE_URL="postgresql://postgres:填你的口令@localhost:5432/kids_points?schema=public"
#   ⚠ 迁移链（顺序不能错；**每条 psql 都必须带 -v ON_ERROR_STOP=1**）：
#     npx prisma migrate dev --name <name>      # 建表（所有者）
#     npm run seed                             # 18 条模板；Prisma 7 的 migrate dev **不会**自动跑（缺陷 11）
#     psql "$MIGRATION_DATABASE_URL" -v ON_ERROR_STOP=1 -f prisma/sql/900_ledger_revoke.sql
#     APP_DB_PASSWORD='<强口令>' psql "$MIGRATION_DATABASE_URL" -v ON_ERROR_STOP=1 \
#       -v app_password="$APP_DB_PASSWORD" -f prisma/sql/901_set_app_password.sql
#     npm run db:verify                        # I5 + 口令判据 P1–P3 实证（可失败）
#   `migrate reset` 之后必须重跑后三步（§10.3）。
#   ★ 为什么每条都要 `-v ON_ERROR_STOP=1`（2026-10-14 在 psql 18.6 上实测，非推断）：
#     脚本内的 RAISE EXCEPTION 在**不带**它时，psql 退出码仍然是 **0** ——
#     检查"执行了"，但脚本调用者与 CI 全都看不见它失败（D12 假绿的同一形状）。

NODE_ENV=development
PORT=3000

# ── 微信小程序凭据（L2 已于 2026-10-29 解除）──────────────────────────────
# ★ 真实值只放 .env（**不入库**）；AppID 同时写进 kids_points_mp/project.config.json
#   —— AppID 是公开信息（会打进小程序包），AppSecret **绝不能**进小程序包 / Flutter 包。
# ★ AppSecret 只给服务端用（`sns/jscode2session` → openId）。泄露即在微信后台重置。
# ★ 判据（可失败，别只看"填好了"）：拿**假** js_code 打 sns/jscode2session ——
#     凭据有效 ⇒ errcode 40029（invalid code）；secret 错 ⇒ 40125（invalid appsecret）。
WECHAT_MP_APPID=""   # 正式 AppID：wx + 16 位 hex
WECHAT_MP_SECRET=""  # 32 位 hex

# ── 认证层开关（W9-A，2026-10-29；见 docs/design/40-login-and-session-design.md §9.4）──
# ★ 双读期旁路：值为 1 时，**没有** Authorization 的请求可以只靠 `x-kp-device-id`
#   （客户端自报的设备标识，不是凭据）继续走旧路径。改造完成后置 0。
# ★ 生产恒不生效：NODE_ENV=production 且此值为 1 ⇒ **启动即抛错**（进程起不来）；
#   生产**必须**显式写 0 —— 不写也视为 1，所以"忘了配"会导致启动失败（fail-closed）。
# ★ 只接受 "0" / "1"（缺省 1）。写 true / yes / on ⇒ 启动抛错：不猜拼错的意思。
AUTH_DEVICE_ID_FALLBACK=0

# ── L4 阻塞项：域名（微信强制 HTTPS + 域名白名单，依赖备案）────────
PUBLIC_BASE_URL=""

# ── App 自更新（W10-B，2026-11-02）────────────────────────────────────
# `GET /app/version` 的数据源（**匿名**端点，不碰数据库）。
# 全部有默认值；配错版本号会回退到默认值，不会 500。
#   APP_LATEST_VERSION   最新版本 x.y.z（与客户端 pubspec.yaml 的 version 对齐）
#   APP_LATEST_BUILD     最新构建号（同版本号时用它区分先后）
#   APP_MINIMUM_VERSION  低于此版本强制更新
#   APP_MINIMUM_BUILD    低于此构建号强制更新
#   APP_DOWNLOAD_URL     APK 直链，必须是 http(s) 绝对地址
#   APP_RELEASE_NOTES    更新说明（纯文本）
#   APP_PUBLISHED_AT     发布时间（UTC ISO，可空；客户端解析失败时忽略）
APP_LATEST_VERSION="1.0.3"
APP_LATEST_BUILD="4"
APP_MINIMUM_VERSION="1.0.0"
APP_MINIMUM_BUILD="1"
APP_DOWNLOAD_URL="https://hub.littlewish.top:8443/app/kids-points-app.apk"
APP_RELEASE_NOTES="新增网站「邀请码获取」页（每天限量）；小程序新增邀请码注册页；注册页说明与错误提示同步更新。"
APP_PUBLISHED_AT=""

# ── 网站「邀请码获取」（W12，2026-11-02）──────────────────────────────────
# `GET /invite` 页面向访客发放**注册邀请码**（绑定手机号 + 邮箱，单次有效）。
# ★ 每日额度是产品承诺，不是硬编码：改这里 + 重启服务即生效，不用发版。
#   `REGISTRATION_INVITE_DAILY_LIMIT`  每个业务日最多发多少张，默认 50；
#                                      合法范围 1..1000，填 0/负数/非数字 ⇒ 回退 50，
#                                      超过 1000 ⇒ 夹到 1000（防「等于没限额」）。
#   `REGISTRATION_INVITE_TTL_DAYS`     每张码的有效期（天），默认 7；
#                                      合法范围 1..30，非法 ⇒ 回退 7。
#   `REGISTRATION_INVITE_IP_DAILY_LIMIT` 同一个来源 IP 每业务日最多发几张，默认 5；
#                                      合法范围 1..20（W12 边界，2026-11-04）。
#                                      挡的是「一个脚本刷完全部名额」，不是「同一屋檐下的第二个人」。
# ★ 「业务日」按 `KP_TIMEZONE` 算（默认 Asia/Shanghai），不是 UTC 日。
REGISTRATION_INVITE_DAILY_LIMIT=50
REGISTRATION_INVITE_TTL_DAYS=7
REGISTRATION_INVITE_IP_DAILY_LIMIT=5

# ── CORS（W10-A，2026-10-30）：Flutter Web 版要用 ─────────────────────
# 浏览器里页面跑在 http://localhost:<端口>，接口在 http://127.0.0.1:3000 ⇒ 跨源。
# 请求带 `authorization` / `x-kp-device-id` ⇒ 浏览器先发 OPTIONS 预检；
# 没有 CORS 响应头时真请求根本不会发出，客户端只看到「连不上服务器」。
# ★ 留空 + NODE_ENV !== production ⇒ 自动放行本机 localhost/127.0.0.1/[::1] 的**任意端口**
#   （`flutter run -d chrome` 每次端口都可能不同，写死一个端口必然踩坑）。
# ★ 生产**必须**显式列出白名单（`,` 分隔，如 https://app.example.com）；
#   留空且 NODE_ENV=production ⇒ CORS 不启用（并打一条 warn），不是"默认全放开"。
# ★ `*` = 允许任何源，只在你确切知道后果时用（凭据走 authorization 头，
#   放开等于任何站点都能借用户浏览器读本接口）。
CORS_ALLOWED_ORIGINS=""

# ── 业务参数（02 §6 / §4.3 / §7 已定稿，此处仅为可配置化留口）──────
DEVICE_SESSION_TTL_MINUTES=5      # 02 §7：5 分钟无操作回落 child
PIN_MAX_ATTEMPTS=5                # 02 §7：连错 5 次
PIN_LOCK_MINUTES=15               # 02 §7：锁定 15 分钟
CHILD_DAILY_BONUS_REQUEST_LIMIT=3 # 02 §6：Q13 = 3 条/天
CHILD_BONUS_AMOUNT_LIMIT=50       # 02 §6：Q15 = 单笔 ±50
APPROVAL_TTL_HOURS=72             # 02 §4.3：审批 TTL 默认 72h
APPROVAL_EXPIRY_SCAN_INTERVAL_MS=60000 # W3-C：过期扫描周期（默认 60s；0/非法 ⇒ 默认）
RECYCLE_BIN_RETENTION_DAYS=90     # 03 C9：Q12 = 配置 90 天可恢复（账本永不删）

# ── 业务时区（W4-D，2026-10-19）：决定「每日打卡上限」按哪一天算 ──────────────
# ★ 默认值就是 Asia/Shanghai，面向中国家庭时**不需要改**；写在这里是因为
#   代码会读它（src/habits/business-day.ts#resolveBusinessTimeZone），
#   而模板里没有它 ⇒ 想改的人不知道有这个开关。
# ★ 必须是 IANA 名称（Asia/Shanghai / Asia/Tokyo …）。拼错（如 Asia/Shanghia）
#   ⇒ **启动即抛 RangeError**，进程起不来。
#   这不是过度严格：静默退回 UTC 会让每日上限按错误的日子算 ——
#   那是家长看得见的承诺，比 500 更难发现（16-w4d-handoff.md §4）。
# ★ 业务日由**数据库时钟**决定，与本进程的 TZ / 容器时区无关；
#   边界是该时区 00:00 起、左闭右开。
KP_TIMEZONE=Asia/Shanghai

# ── 推送网关（W6-A，2026-10-24；见 docs/design/29-w6a-handoff.md）────────────
# ★ 不配 ⇒ PUSH_PORT 绑 NoopPushAdapter，推送如实返回 provider_not_configured（**不是故障**）。
# ★ 配错（非法 URL / 非 http(s) / 生产用 http）⇒ 仍是 no-op，但启动日志打 **error** —— 
#   否则「我明明配了」与「一条都没发」会长期共存而没人知道。
PUSH_WEBHOOK_URL=""               # 例：https://push-gateway.example.com/push（生产必须 https：请求体含设备 token）
PUSH_WEBHOOK_TOKEN=""             # 可选；非空 ⇒ 带 authorization: Bearer <token>
PUSH_WEBHOOK_TIMEOUT_MS=800       # 默认 800；夹在 [100, 5000]，且必须 < PUSH_SEND_TIMEOUT_MS（1000ms 兜底）

# ── 推送失败重试（W6-B，2026-10-24）──────────────────────────────────────────
# ★ 只影响**已经入队**的失败推送；它不改变业务请求的响应（业务路径始终只发一次）。
# ★ PUSH_RETRY_ENABLED=0 ⇒ worker 不启动，失败推送停在 pending（启动日志会 warn）。
PUSH_RETRY_ENABLED=1                  # 默认 1；只有 0/false/off/no 才关（拼错 ⇒ 保持开启）
PUSH_RETRY_INTERVAL_MS=15000          # 每轮间隔，默认 15s；夹在 [1000, 300000]
PUSH_RETRY_BATCH=20                   # 每轮最多领 20 条；夹在 [1, 100]
PUSH_RETRY_TTL_MS=86400000            # 默认 24h；夹在 [60000, 604800000（7 天）]
PUSH_RETRY_MAX_ATTEMPTS=6             # 渠道类失败最多 6 次（30s→1m→2m→4m→8m→16m，封顶 30m）；夹在 [1, 20]
PUSH_RETRY_CLAIM_TIMEOUT_MS=60000     # 领走 60s 还没结算 ⇒ 视为进程崩溃，允许重新领取；夹在 [10000, 600000]

# ── 通知 / 推送对账（W6-D，2026-10-24）──────────────────────────────────────
# ★ 只读、只告警、**绝不自动补发**：发现缺口按 docs/design/32-w6d-handoff.md §4 人工处置。
# ★ 状态分布（dead/expired/pending）不算漂移 —— 没配网关时告警会永远为真。
NOTIFICATIONS_RECONCILE_ENABLED=1         # 默认 1；只有 0/false/off/no 才关（关闭后缺口不会告警）
NOTIFICATIONS_RECONCILE_INTERVAL_MS=300000  # 默认 5 分钟；夹在 [60000, 3600000]

# ── PushRetryJob 保留清理（W6-D，2026-10-24）────────────────────────────────
# ★ 只删 sent / expired / dead；pending / sending 永不删（删了等于丢消息 / 重复发送）。
# ★ dead 保留更久是因为**它是证据**（渠道反复失败要事后复盘）。
# ★ 时间字段是 updatedAt（人工改过行的 lastError 会把它从改动时刻重算）。
PUSH_RETRY_RETENTION_ENABLED=1            # 默认 1；只有 0/false/off/no 才关
PUSH_RETRY_RETENTION_INTERVAL_MS=3600000  # 默认 1 小时；夹在 [60000, 86400000]
PUSH_RETRY_RETENTION_SENT_MS=604800000    # sent 保留 7 天；夹在 [60000, 31536000000]
PUSH_RETRY_RETENTION_EXPIRED_MS=604800000 # expired 保留 7 天；同上
PUSH_RETRY_RETENTION_DEAD_MS=2592000000   # dead 保留 30 天；同上
PUSH_RETRY_RETENTION_BATCH=500            # 每批最多删 500 行；夹在 [1, 5000]，每状态每轮最多 10 批

