{
  // 用途：src + test 一起**真编译**成 CJS，供 npm test 在编译产物上跑
  // —— 见 scripts/run-tests.mjs 文件头「为什么不能继续用 tsx」。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".tmp_test_build",
    "types": ["node"],
    "incremental": false,
    "sourceMap": false,
    "declaration": false
  },
  // ★ W2-B：真库套件（`test-db/*.dbtest.ts`）也一起编译 —— 于是它在**无库 CI** 里
  //   照样过类型检查（`typecheck:tests`），只是不跑；跑它要 `npm run test:db`。
  "include": ["src/**/*.ts", "test/**/*.ts", "test-db/**/*.ts"]
}
