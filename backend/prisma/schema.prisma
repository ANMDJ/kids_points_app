// ═══════════════════════════════════════════════════════════════════════════
//  kids_points_api · Prisma schema
//
//  依据：docs/design/01 §5（数据模型总览）、02 §4/§5/§7/§8、03 C9–C11/E15–E17、04 §3/§5
//
//  ★ 关键事实（与 01 §5 的表述有出入，见 docs/design/06-w0-report.md §2）：
//    01 §5 写「新增 11 张 + 改造 5 张」，但仓库内**从未存在过后端与数据库** ——
//    那 5 张「既有表」只存在于客户端内存模型里。因此 W0 必须**一次创建全部 18 张表**，
//    不存在「对既有库做 ALTER」这件事。
//
//  ★ 不可拆分性（01 §5.3）：PointRuleVersion + 不可变 PointRecord + 软删除 + AuditLog
//    是同一次 schema 变更。本文件一次性包含全部四者。
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // ★ Prisma 7 破坏性变更：`url` 已**不再支持**写在 schema 里
  //   （P1012: The datasource property `url` is no longer supported in schema files）。
  //   连接串移至 prisma.config.ts 的 datasource.url，客户端则通过 driver adapter 接入。
  //   来源：https://pris.ly/d/config-datasource
  //   —— 这一点是 01 §1 写「Prisma 7.10.0」时未预见的，见 06-w0-report.md §2。
}

// ─────────────────────────────── 枚举 ───────────────────────────────

/// 02 §1：成员位角色。viewer 为「只读分享」预留（02 §1 场景表最后一行）。
enum MemberRole {
  guardian
  child
  viewer
}

/// 02 §1：成员位状态。
enum MemberStatus {
  active
  removed
}

/// 用户状态（用户注销权见 02 §5.6 边界情况）。
enum UserStatus {
  active
  suspended
  deleted
}

/// 监护关系取值（06 §3.1 决策 **D1b**，阶段 D-a）：自由字符串 → 枚举。
///
/// ★ 这份取值要**手抄三处**（枚举本身、`UserChildRelation.relation` 的注释、
///   迁移 SQL 的 `CREATE TYPE "RelationKind"`），与 D9 的图标名同一类漂移病：
///   写错一处时三端编译器都不会说一句话。故由 `npm run relation:check`
///   （`tools/relation-kind-check.mjs`）逐字比对 —— 改这里必须同时改那两处。
enum RelationKind {
  father
  mother
  grandparent
  other
}

/// 02 §4.1：审批终态集合 = approved / rejected / withdrawn / invalidated / expired。
enum ApprovalStatus {
  pending
  approved
  rejected
  withdrawn
  invalidated
  expired
}

/// 02 §4.2：仅 invalidated 时存在的自动原因（区分「家长不同意」与「前提消失」）。
enum AutoReason {
  WISH_DELETED
  RULE_DELETED
  HABIT_GONE
  INSUFFICIENT_POINTS
  MEMBER_REMOVED
}

/// 02 §5.3：奖惩方向。points 恒为正，正负由 direction 表达（修 A1 的根源）。
enum RuleDirection {
  reward
  penalty
}

/// 03 C9：软删除统一状态（规则 / 习惯 / 心愿共用）。
enum RecordStatus {
  active
  deleted
}

/// 客户端既有分类（Taro types.ts `RecordCategory`，Flutter `RecordCategory`）。
enum RecordCategory {
  praise
  exchange
  adjust
}

/// 客户端既有来源（修 A4；值必须与双端 `RecordSource` 一一对应）。
enum RecordSource {
  child_self
  guardian
  agent
  approval
  system
  correction
}

/// 04 §2 步骤③：学段（模板过滤依据）。
enum AgeBand {
  preschool
  primary_low
  primary_high
  junior_high
}

/// 03 E16：配色改为**稳定枚举**，不再用数组下标（删项后不漂移）。
enum WishCoverStyle {
  A
  B
  C
  D
}

/// 04 §5 + 02 §9.20：监护人同意状态（撤回后引导入口重新出现）。
enum ConsentStatus {
  granted
  withdrawn
}

/// 家庭数据删除请求的状态（W7-D，2026-10-27）。
///
/// ── 为什么不是「一按就删」─────────────────────────────────────────────────
///   `pending` 是**冷却期**：家长申请后仍有 7 天可以改变主意。删除是不可逆的
///   匿名化，误触的代价不可挽回；冷却期把「决定」与「执行」拆成两个时刻。
///   `cancelled` 是**历史**（申请过又撤回），不是「没申请过」—— 保留它是为了让
///   撤销这件事本身可审计，也让界面能回答「我上次是不是点过」。
///   `executed` 是**终态**：匿名化已完成，`summary` 记录做了哪些事。
enum FamilyDeletionStatus {
  pending
  cancelled
  executed
}

/// 推送平台（03 §L3：双端目前零推送依赖）。
enum DevicePlatform {
  weapp
  ios
  android
}

/// 02 §2：ActionType —— 与 PERMISSION_MATRIX 的键**必须逐一对应**（38 个）。
/// 该矩阵同时被 HTTP Guard 与 Agent action-dispatcher 消费（02 §3 屏障二）。
enum ActionType {
  view_child_points
  view_records
  view_rules
  view_wishes
  check_in_habit
  undo_check_in
  add_rule
  update_rule
  delete_rule
  add_habit_from_rule
  add_wish
  request_redeem
  delete_wish
  delete_habit
  view_trash
  restore_trash_item
  purge_trash_item
  adjust_points
  request_points_bonus
  redeem
  request_approval
  review_approvals
  withdraw_request
  view_own_approvals
  /// 站内通知（W5-L）：收件人按会话 userId 收口。
  view_notifications
  read_notifications
  /// 设备推送（W6-A）：上报 / 注销**自己的** `DeviceToken`，会话 actor 收口。
  manage_device_tokens
  view_members
  change_member_role
  invite_member
  remove_member
  switch_role_mode
  edit_child_profile
  /// 家长 PIN 的设置 / 修改（W8-C，02 §7）。只给家长；同意闸门**豁免**
  /// （PIN 是家长自己的凭据，且它是"没 PIN ⇒ 进不了家长模式 ⇒ 无法重新同意"的出口）。
  manage_parent_pin
  /// 首启引导（W8-A）：读（`view_onboarding`，同意闸门**豁免** —— 第①步就是同意，
  /// 页必须先能打开）与写（`apply_onboarding`，受同意闸门管 —— 第②步起采集昵称）。
  view_onboarding
  apply_onboarding
  /// 合规与监护人同意（W7-A）：看 / 授予 / 撤回同意。
  /// 这两个动作是「撤回后写入停止」的豁免口（contracts/consent-policy.ts）。
  view_consent
  manage_consent
  /// 数据导出（W7-C）：家长导出整份家庭数据；`child` 为 DENY。
  export_family_data
  /// 家庭数据删除（W7-D）：看删除状态 / 申请与撤回删除；`child` 均为 DENY。
  /// ★ 两个动作都在 `contracts/consent-policy.ts` 的**豁免**集合里 ——
  ///   撤回同意后仍必须能行使删除权（否则「撤回」等于「数据被扣住」）。
  view_family_deletion
  manage_family_deletion
  reset_demo_data
}

// ═══════════════════ 一、身份与成员（02 §1） ═══════════════════
//  ★ 文档空白：`User` 与 `UserChildRelation` 被 02 §1 引用，但**从未给出字段定义**。
//    以下为 W0 补齐的字段，见 06-w0-report.md §3「待确认决策 D1」。

/// 自然人（一个家长一个 User）。
model User {
  id          String     @id @default(cuid())
  /// 微信 openid / unionid。L2（主体认证）完成前可能为空。
  openId      String?    @unique
  displayName String?
  /// scrypt 哈希；禁止明文，禁止客户端持有（02 §2 架构约束）。
  status      UserStatus @default(active)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  relations          UserChildRelation[]
  members            ChildMember[]
  deviceSessions     DeviceSession[]
  /// 认证会话（W9-A，2026-10-29 / `40` §5）：**"你是谁"**，与 DeviceSession 分工。
  authSessions       AuthSession[]
  deviceTokens       DeviceToken[]
  changedVersions    PointRuleVersion[]
  operatedRecords    PointRecord[]       @relation("RecordOperator")
  submittedApprovals ApprovalRequest[]   @relation("ApprovalRequester")
  decidedApprovals   ApprovalRequest[]   @relation("ApprovalDecider")
  createdInviteCodes InviteCode[]        @relation("InviteCreator")
  usedInviteCodes    InviteCode[]        @relation("InviteUser")
  consents           GuardianConsent[]
  /// 该用户作为申请人发起的家庭数据删除请求（W7-D）。
  familyDeletionRequests FamilyDeletionRequest[] @relation("FamilyDeletionRequester")
  auditLogs          AuditLog[]
  notifications      Notification[]
}

/// 监护关系（02 §1）。**注意：它不是权限判定的入口** ——
/// 权限一律走 ChildMember（02 §1：ChildMember 是权限判定的唯一入口）。
model UserChildRelation {
  id        String   @id @default(cuid())
  userId    String
  childId   String
  /// 关系描述（06 §3.1 D1b）：原为自由字符串 —— 写错一个字母也不会被任何人拦下。
  /// 关系取值：father / mother / grandparent / other
  /// ★ 上面这行是**第三份手抄**（另两份：`enum RelationKind`、迁移 SQL 的 CREATE TYPE），
  ///   `npm run relation:check` 逐字比对；改这里必须同时改那两处。
  relation  RelationKind
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([userId, childId])
  @@index([childId])
}

/// 孩子档案。
model Child {
  id String @id @default(cuid())

  /// 昵称。引导第②步就采集 → 因此同意必须在第①步取得（04 §5）。
  name String

  /// ★ 权威余额。所有变更必须在 $transaction 内与 PointRecord 一同写入（01 §4）。
  pointsBalance Int @default(0)

  // ── 04 §3：引导三字段 ──────────────────────────────────────────
  ageBand     AgeBand?
  focusAreas  String[]  @default([])
  /// null = 未完成引导 → 前端强制进入引导（04 §3：引导的权威状态，服务端持有）
  onboardedAt DateTime?

  // ── 软删除（03 C9）────────────────────────────────────────────
  status    RecordStatus @default(active)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 注意：客户端的 goodHabitCount / rewardCount **不落库** ——
  // 它们是聚合结果，落库正是 A5（奖励次数虚高）的成因。改为按需 SELECT COUNT。
  // 见 06-w0-report.md §3「待确认决策 D2」。

  relations          UserChildRelation[]
  members            ChildMember[]
  rules              PointRule[]
  records            PointRecord[]
  habits             Habit[]
  wishes             Wish[]
  approvals          ApprovalRequest[]
  inviteCodes        InviteCode[]
  consents           GuardianConsent[]
  /// 家庭数据删除请求（W7-D）。
  familyDeletionRequests FamilyDeletionRequest[]
  notifications      Notification[]
  deviceSessions     DeviceSession[]
  deviceTokens       DeviceToken[]
  auditLogs          AuditLog[]
  idempotencyRecords IdempotencyRecord[]

  @@index([status])
}

/// 成员位（02 §1）★ 新增 —— 权限判定的唯一入口。
model ChildMember {
  id      String       @id @default(cuid())
  childId String
  userId  String
  role    MemberRole
  status  MemberStatus @default(active)

  joinedAt        DateTime  @default(now())
  removedAt       DateTime?
  invitedByUserId String?

  // ── 02 §7：PIN（scrypt 哈希）──────────────────────────────────
  pinHash        String?
  pinSetAt       DateTime?
  /// 02 §7：连错 5 次锁定 15 分钟（计数落在成员位上，而非设备上 —— 见 06 §3 D3）
  pinFailedCount Int       @default(0)
  pinLockedUntil DateTime?

  /// 02 §3 屏障三：成员级收紧。**只能更严、不能更松**（方向性约束）。
  /// 形状：{ childCannotUndoCheckIn?, childCannotAddWish?, requireApprovalForBonusOver? }
  restrictions Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 02 §1：同一人对同一孩子只有一个成员位。
  @@unique([childId, userId])
  @@index([userId, status])
}

/// 02 §7：服务端持有的 activeRole（**不信客户端**）。
/// 客户端 storage 可被直接修改，服务端持有才能让「家长模式」成为真实的权限提升。
model DeviceSession {
  id       String @id @default(cuid())
  deviceId String
  childId  String
  userId   String

  /// 服务端权威。默认 child（最小权限默认，02 §7）。
  activeRole MemberRole @default(child)

  issuedAt   DateTime @default(now())
  /// TTL 5 分钟，到期回落 child；每次 guardian 操作刷新（02 §7）。
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceId, childId])
  @@index([expiresAt])
}

/// 认证会话（W9-A，2026-10-29 / `docs/design/40-login-and-session-design.md` §5）。
///
/// ── 它回答的问题与 `DeviceSession` **不同** ────────────────────────────────────
///   · 本表：**"你是谁"**（微信 `code2session` → openId → 这个人）。跨设备、跨孩子。
///   · `DeviceSession`：**"你在这台设备的这个孩子上是什么角色"**（含 5 分钟家长模式窗口）。
///   合并它们的代价已经在 W8-C 付过一次：同一列 `expiresAt` 既是"邀请码给的 30 天身份"
///   又是"PIN 换来的 5 分钟家长模式"，`parentModeSourceOf()` 只能靠算术猜来源。
///
/// ── 凭据形态：不透明随机 token（**不是 JWT**，理由见 `40` §4）──────────────
///   明文形如 `kps_<base64url(32B)>`，**只在登录响应里出现一次，绝不落库**；
///   库里只存 `sha256(明文)` 的 64 位十六进制。撤销本来就要查库，JWT 的无状态优势归零。
///
/// ── 为什么 `method` 是 String 而不是 PG 枚举 ─────────────────────────────────
///   `RelationKind` 的教训：枚举值要在三处逐字一致（schema / 迁移 / 注释），
///   还要一条 `npm run relation:check`。`method` 只有两个值、只被服务端写、
///   **永不参与权限判定** ⇒ 用 `String` + 应用层白名单（读到白名单外的值 ⇒ **500 形状错**，
///   与 `session.gate.ts#INVALID_SESSION_ROLE` 同一口径）。
model AuthSession {
  id     String @id @default(cuid())
  userId String

  /// `sha256(token)` 的十六进制（64 字符）。★ 与 `ChildMember.pinHash` 的 scrypt 不同：
  /// token 有 256 bit 熵，慢哈希是负收益（每个请求多 30ms CPU）。
  tokenHash String @unique

  /// 认证方式白名单：`wechat_mp` | `dev_seed`（后者仅非生产）。
  method String

  /// 签发时客户端自报的设备标识：**只进审计，不参与任何判定**（`40` §5.1 第 2 条）。
  /// ★ 它是客户端生成的稳定 id，不是凭据；凭据只有 `tokenHash`。
  deviceId String?

  issuedAt DateTime @default(now())
  /// 只回答"这台设备还活着吗"（运营/审计），**不参与过期判定**。
  /// ⚠️ 顺手拿它延长 `expiresAt` 是本设计最容易发生的退化 —— 那会变成滑动窗口，
  ///    手机丢了之后凭据无限期活着（`40` §4.3）。
  lastSeenAt DateTime @default(now())
  /// 绝对到期（7 天）：**不因使用而延长**。
  expiresAt DateTime

  revokedAt     DateTime?
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// 推送 token（03 L3：双端目前零推送依赖，此表为 W6 预留）。
model DeviceToken {
  id       String         @id @default(cuid())
  userId   String
  childId  String?
  platform DevicePlatform
  token    String         @unique
  active   Boolean        @default(true)

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([userId, active])
}

// ═════════ 二、规则与账本（02 §5 · 本项目最不可妥协的部分） ═════════

/// 积分规则（家长约定「做到什么 → 得多少分」）。
/// 修 A2（`dailyLimit` 结构化）、A3、C9（软删除）、C10（可编辑，靠 currentVersion）、
/// E15（`condition`/`dailyLimit` 升为结构字段，`detail` 降级为派生展示串，不再落库）。
model PointRule {
  id      String @id @default(cuid())
  childId String

  title      String
  /// ★ 结构字段（原 `detail` 第一段）。03 E15：不再靠 `split(' · ')` 反解析。
  condition  String
  /// ★ 结构字段（原 `limitText`）。03 A2：频次必须是可运算、可校验的数字。
  dailyLimit Int
  /// 恒为正；奖惩由 direction 表达 —— 修 A1 的根源（`Math.abs()` 抹平负分）。
  points     Int
  direction  RuleDirection

  icon  String
  color String

  /// 当前版本号。每次 update_rule 在**同一事务内** +1（02 §5.3）。
  currentVersion Int @default(1)

  // ── 软删除（03 C9）：可软删，90 天内可恢复；回收站只作用于「配置」 ──
  status    RecordStatus @default(active)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child    Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  versions PointRuleVersion[]
  habits   Habit[]

  @@index([childId, status])
  @@index([childId, deletedAt])
}

/// ★ 规则版本（02 §5.3）—— **只增不删，永久保留**。
///
/// 为什么必须有：只有 `ruleId` 时，记录指向的是**已变形的规则**，
/// 历史失去可解释性（02 §5.1 的反例：`+1` 的流水在规则改成 `+3` 后无法解释）。
///
/// 「规则被软删」与「版本被删除」是两件事：规则主体可软删，
/// 版本永不删 —— 否则 `rec#1` 的 `(ruleId, ruleVersion)` 指向空，承诺失效（02 §5.6）。
model PointRuleVersion {
  id      String @id @default(cuid())
  ruleId  String
  version Int

  // ── 全量真相（不可变快照）──────────────────────────────────────
  title      String
  condition  String
  dailyLimit Int
  points     Int
  direction  RuleDirection

  changedByUserId String
  changedAt       DateTime @default(now())
  changeNote      String?

  rule      PointRule     @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  /// ★ 规则版本必须能回答「谁改的」—— 与 03 C11（变更不可追溯）同类要求。
  ///   onDelete: Restrict：审计性记录不得因删除用户而丢失作者。
  changedBy User          @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)
  records   PointRecord[]

  /// 02 §5.3。★ 此唯一约束同时被 PointRecord 的复合外键引用 →
  /// **I3 不变量（每条记录的 (ruleId, ruleVersion) 必能命中版本行）由数据库强制**。
  @@unique([ruleId, version])
}

/// ★ 积分流水（账本，**append-only**）。
///
/// - 撤销用**冲正**（`reversesRecordId`），绝不删改 —— 修 B7
/// - `balanceAfter` 是账本对账基准 —— 修 B6
/// - `operatorUserId` / `operatorRole` 记录真实操作人 —— 修 A4（原先硬编码「家长记录」）
/// - `titleSnapshot` 完整不截断 —— 修 B8
/// - 客户端 `subtitle` **不落库**：它由 `source + createdAt + note` 派生 —— 修 A4/E19
model PointRecord {
  id      String @id @default(cuid())
  childId String

  // ── 引用层：定位「当时的规则完整是什么」（02 §5.1）──────────────
  ruleId         String?
  ruleVersion    Int?
  /// ★ 复合外键 → PointRuleVersion(ruleId, version)。
  /// 数据库层保证 I3：不存在指向空版本的历史记录。
  ruleVersionRef PointRuleVersion? @relation(fields: [ruleId, ruleVersion], references: [ruleId, version], onDelete: Restrict)

  habitId String?
  wishId  String?

  // ── 快照层（反规范化，仅为列表渲染不必 join；与版本行不一致时以版本行为准）──
  titleSnapshot      String
  conditionSnapshot  String?
  dailyLimitSnapshot Int?
  costSnapshot       Int?

  // ── 变动本身 ───────────────────────────────────────────────────
  /// 正数为加分，负数为扣分。**不可变**。
  pointsDelta Int
  category    RecordCategory
  source      RecordSource
  note        String         @default("")

  /// 真实操作人（`system` / `correction` 时可为空）—— 修 A4
  operatorUserId String?
  operatorRole   MemberRole?

  /// ★ 记完之后的余额 —— 修 B6。缺失即无法对账。
  balanceAfter Int

  /// 幂等键：防重放重复扣分（02 §4.4）
  idempotencyKey String?

  // ── 冲正关系（02 §5.7 I6）──────────────────────────────────────
  reversesRecordId String?
  reversesRecord   PointRecord?  @relation("RecordReversal", fields: [reversesRecordId], references: [id], onDelete: Restrict)
  reversedBy       PointRecord[] @relation("RecordReversal")
  reversedAt       DateTime?

  /// 由哪条审批执行产生（02 §4.3 的 `executedRecordId` 的另一侧）
  executedByApproval ApprovalRequest?

  createdAt DateTime @default(now())

  child    Child  @relation(fields: [childId], references: [id], onDelete: Restrict)
  habit    Habit? @relation(fields: [habitId], references: [id], onDelete: Restrict)
  wish     Wish?  @relation(fields: [wishId], references: [id], onDelete: Restrict)
  operator User?  @relation("RecordOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)

  /// 幂等键在**同一孩子**范围内唯一。
  @@unique([childId, idempotencyKey])
  /// I2 对账：按 (childId, createdAt) 排序滚动求和 == balanceAfter。
  @@index([childId, createdAt])
  @@index([childId, source, createdAt])
  @@index([ruleId, ruleVersion])
}

/// 可打卡的习惯（首页「今天的习惯」）。
///
/// 修 A2（`dailyLimit`）、A3（`checked` 派生）、C9（软删除）、E17（`limitText`/`doneText` 派生）。
/// ★ **不落库**的字段：`checked` / `doneText` / `limitText` ——
/// 03 E17：它们一旦被外部写入就必然与真实状态脱节；改为由 `dailyLimit` + 今日计数计算。
model Habit {
  id      String @id @default(cuid())
  childId String

  /// 由某条规则采纳而来（`addHabitFromRule`）。采纳即复制，与规则脱钩后仍保留来源。
  sourceRuleId String?

  title      String
  points     Int
  condition  String
  /// 修 A2：频次上限是数字，不是自由文本。
  dailyLimit Int

  icon  String
  color String

  status    RecordStatus @default(active)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child      Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  sourceRule PointRule?    @relation(fields: [sourceRuleId], references: [id], onDelete: SetNull)
  records    PointRecord[]

  @@index([childId, status])
}

/// 心愿（可兑换的奖励）。
/// 修 C9（软删除）、E16（`coverStyle` 稳定枚举替换 `backgroundIndex` 数组下标）。
model Wish {
  id      String @id @default(cuid())
  childId String

  title      String
  /// 兑换所需积分（**快照进审批 payload 的 `costSnapshot`**，见 02 §4.3）
  cost       Int
  emoji      String
  /// ★ 03 E16：稳定枚举。原先 `wishes.length % 4` 会因删项而漂移/撞色。
  coverStyle WishCoverStyle @default(A)

  redeemed   Boolean   @default(false)
  redeemedAt DateTime?

  status    RecordStatus @default(active)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child   Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  records PointRecord[]

  @@index([childId, status])
}

// ═════════ 三、审批 / 邀请 / 合规 / 审计 / 模板 ═════════

/// 02 §4.1：审批请求状态机（5 个终态 + pending）。
///
/// 为什么必须有 `invalidated`（02 §4.2）：审批是**跨时间**的，家长 3 小时后才点同意时
/// 前提可能已消失（心愿被删、积分被花掉、规则被删、成员被移出）。
/// 与 `rejected`（人的决定）语义不同，UI 上必须区分 —— 否则家长「莫名其妙背锅」。
model ApprovalRequest {
  id              String     @id @default(cuid())
  childId         String
  requesterUserId String
  requesterRole   MemberRole

  actionType ActionType
  /// 动作参数**快照**。必须含 `costSnapshot`（02 §4.3）：
  /// 否则家长同意时心愿价格已被改过，扣分金额与孩子申请时看到的不一致 —— 又一次账对不上。
  payload    Json

  status     ApprovalStatus @default(pending)
  /// 仅 `invalidated` 时存在（02 §4.2）
  autoReason AutoReason?

  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?

  /// TTL，默认 72h；到期由扫描任务置 `expired`（02 §4.3）。
  expiresAt DateTime

  /// 批准并执行后产出的流水（02 §4.3）。**1:1**，故 @unique。
  executedRecordId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child          Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  requester      User         @relation("ApprovalRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  decidedBy      User?        @relation("ApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  executedRecord PointRecord? @relation(fields: [executedRecordId], references: [id], onDelete: Restrict)

  @@index([childId, status, createdAt])
  /// 供 TTL 扫描（02 §4.3）
  @@index([status, expiresAt])
}

/// 02 §8：邀请码。★ 并发安全的要点在**使用侧**，不在表本身 ——
/// 必须用单条条件 UPDATE（`used_count < max_uses` 与自增在同一语句内）原子占位，
/// 而不是「先查后改」。参见 06-w0-report.md §3「待确认决策 D5」（§8 的示例 SQL 用了
/// snake_case 列名，而本 schema 未使用 @map，需改写为带引号的 camelCase）。
model InviteCode {
  id      String     @id @default(cuid())
  childId String
  code    String     @unique
  /// 不能给别人比自己更高的角色（02 §8）。
  role    MemberRole

  maxUses   Int
  usedCount Int @default(0)

  usedByUserId String?
  usedAt       DateTime?

  expiresAt DateTime
  revoked   Boolean  @default(false)

  createdByUserId String
  createdAt       DateTime @default(now())

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  usedBy    User? @relation("InviteUser", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([childId, revoked])
  /// 原子占位语句的 WHERE 依赖 (code, expiresAt, revoked)
  @@index([code, revoked, expiresAt])
}

/// 04 §5：监护人同意记录（合规前置）。
///
/// 必须放在引导第①步而非设置页：儿童个人信息的同意**必须在采集之前**取得，
/// 而引导第②步就开始采集昵称 —— 放到设置页等于「先采集后征求」（04 §5）。
model GuardianConsent {
  id              String @id @default(cuid())
  childId         String
  grantedByUserId String

  /// 协议版本号（《用户协议》《儿童个人信息保护规则》定稿后写入）
  consentVersion String
  status         ConsentStatus @default(granted)

  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  /// 不存原始 IP，只存哈希（最小化个人信息）
  ipHash        String?
  userAgentHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  grantedBy User  @relation(fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@index([childId, status])
}

/// 家庭数据删除请求（W7-D，2026-10-27）。
///
/// ── 它记录的是「一次决定」，不是「一份数据」────────────────────────────────
///   删除本身没有第二份表 —— 匿名化是就地改列（见
///   `src/deletion/deletion.prisma.repository.ts`）。本表保存的是：
///   谁在什么时候申请、冷却期到什么时候、最后是撤销了还是执行了。
///
/// ── 为什么冷却期是**落库的时间点**而不是「进程里的定时器」───────────────
///   定时器在重启后消失，而「7 天后删除」的承诺必须跨重启成立。因此
///   `scheduledFor` 是一个**可查询的截止时刻**，由 worker 扫描到期行执行。
///
/// ── 为什么 `summary` 是 Json ──────────────────────────────────────────────
///   执行摘要描述的是「这一次实际匿名化了多少行 / 保留了多少流水」，
///   它是**事发当时的证据**，不应随代码版本变化被重算。原样落库，读取时原样回放。
model FamilyDeletionRequest {
  id String @id @default(cuid())

  childId String
  /// 申请人（guardian）。执行后仍需保留：审计要回答「谁申请了删除」。
  requestedByUserId String

  status FamilyDeletionStatus @default(pending)

  requestedAt DateTime @default(now())
  /// 冷却期结束时刻 = `requestedAt + FAMILY_DELETION_COOLING_DAYS`。
  scheduledFor DateTime

  cancelledAt DateTime?
  executedAt  DateTime?

  /// 执行摘要：各表被匿名化的行数 / 保留的流水条数 / 余额（账本完整性证据）。
  summary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child       Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("FamilyDeletionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([childId, status])
  /// worker 的扫描键：`status = pending AND scheduledFor <= now`。
  @@index([status, scheduledFor])
}

/// 03 C11：变更审计（追加式）。
/// - 与业务写入**同一事务**；DB 层 `REVOKE UPDATE, DELETE`（见 prisma/sql/900_ledger_revoke.sql）
/// - 白名单模型：规则 / 心愿 / 习惯 / 成员 / 同意
model AuditLog {
  id      String  @id @default(cuid())
  childId String?

  actorUserId String?
  actorRole   MemberRole?
  /// 动作标识，如 `point_rule.update`（02 §5.3 第 4 步）
  action      String
  targetType  String
  targetId    String?

  /// 变更前后快照（JSON）
  before Json?
  after  Json?

  /// 02 §7：角色切换需记录 deviceId
  deviceId String?
  ipHash   String?

  createdAt DateTime @default(now())

  child Child? @relation(fields: [childId], references: [id], onDelete: SetNull)
  actor User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

/// 站内通知（01 §5.1）。
/// ★ 01 §4：推送/通知**必须排除在账本事务之外** ——
/// 推送服务不可靠，若放进事务，一次模板消息失败会回滚一笔已经成立的加分。
model Notification {
  id              String      @id @default(cuid())
  childId         String
  recipientUserId String?
  recipientRole   MemberRole?

  /// 类型标识，如 `approval.approved` / `approval.invalidated` / `reward.redeemed`
  type    String
  title   String
  body    String
  payload Json?

  readAt DateTime?

  createdAt DateTime @default(now())

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recipient User? @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, readAt])
  @@index([childId, createdAt])
}

/// 推送失败重试队列的状态（W6-B，2026-10-24）。
///
/// ── 五个状态各自回答一个问题 ────────────────────────────────────────────────
///   pending  —— 还没送（或失败后等待下次重试）；`nextAttemptAt` 是「什么时候可以再试」；
///   sending  —— 已被 worker 领走（`claimedAt`）；进程崩了要能被**超时回收**；
///   sent     —— 网关受理（`providerMessageId` 可能为 null，不编造）；
///   dead     —— 试满 `maxAttempts` 仍失败（渠道真的坏了，需要人看）；
///   expired  —— 超过 `expiresAt` 仍未送出（例如 24 小时都没配上网关）。
///
/// ★ `dead` 与 `expired` 必须在运维上分开：前者是**渠道故障**（重试耗尽），
///   后者是**一直没有渠道 / 一直没有设备**（结构性的）。混成一个「失败」，
///   排查时只能看到「有 300 条没发出去」，却不知道该修网关还是该修客户端。
enum PushRetryStatus {
  pending
  sending
  sent
  dead
  expired
}

/// 推送失败重试队列（W6-B，2026-10-24）。
///
/// ── 它**不是**完整 outbox（诚实边界）────────────────────────────────────────
///   W6-A 的发送仍是**同步先试一次**（`NotificationsService` 1s 兜底）。
///   本表只收「试过了、没送达」的那些事实，由 worker 按退避重试。
///   完整 outbox（业务事务内同写、请求内完全不发送）需要先把通知的入队
///   挪进账本事务边界内，那会改变 `01` §4 的语义 —— 见 30 号交接单 §5。
///
/// ── 为什么**没有** User / Child 外键 ─────────────────────────────────────────
///   这是一条「投递事实」：用户被移出 / 孩子被删之后，仍然要能回答
///   「那条推送到底发了没有」。加 `onDelete: Cascade` 会让删除孩子顺手抹掉
///   故障记录（正是最需要被看到的时候）。
///   `recipientUserId` / `childId` 因此是**字符串记录**，不是关系约束。
model PushRetryJob {
  id String @id @default(cuid())

  /// 事件类型，恒等于 `payload.type`（便于按事件计数，不必解 JSON）。
  event String
  /// 去重键：**同一事实只入队一次**（唯一约束兜住并发 / 重放）。
  /// 形状见 `src/notifications/push-retry.types.ts` 的 `buildPushRetryDedupeKey`。
  dedupeKey String @unique
  /// 消息原文（`PushMessage` 的 JSON）：worker 原样送回 `PushPort`，不重新拼装。
  payload Json

  /// 收件人 / 孩子：只用于排查与计数，**不参与**发送决策（收件人已在 payload 里）。
  recipientUserId String
  childId         String

  status PushRetryStatus @default(pending)
  /// 已消耗的尝试次数。★ 只有**渠道故障**才 +1；「没设备」「没配网关」不消耗
  /// （它们是结构性的，不是渠道坏了），见 `push-retry.policy.ts`。
  attempts    Int      @default(0)
  maxAttempts Int      @default(6)

  /// 下次可以领取的时刻；入队即「立刻可试」。
  nextAttemptAt DateTime  @default(now())
  /// 超过它仍未送达 ⇒ `expired`（不再无限期占着队列）。
  expiresAt     DateTime
  /// 最近一次被 worker 领走的时刻（`sending` 的回收依据）。
  claimedAt     DateTime?

  lastError         String?
  providerMessageId String?
  sentAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 领件：`status + nextAttemptAt` 是唯一的排序/过滤组合。
  @@index([status, nextAttemptAt])
  /// 运维：「这个人的推送怎么老是失败」。
  @@index([recipientUserId, createdAt])
  /// 过期清扫。
  @@index([expiresAt])
  /// W6-D 保留清理：按 `status` 批量删「早于截止线」的行（`ORDER BY updatedAt`）。
  /// 没有它，`DELETE` 只能靠 `status` 前缀索引取出该状态全部行再排序 ——
  /// `sent` 会随审批量增长，正是最先变慢的那一档。
  @@index([status, updatedAt])
}

/// 02 §4.4：幂等记录。防「双击同意」「网络重试」导致的重复扣分。
/// 与 `PointRecord.idempotencyKey` 配合：唯一约束在数据库层兜底，不能只靠应用判断。
model IdempotencyRecord {
  id      String  @id @default(cuid())
  /// 幂等键由客户端生成（UUID），同一孩子范围内唯一
  key     String
  childId String
  userId  String?

  actionType  ActionType
  /// 请求体哈希：同一键但不同请求体 → 视为冲突，不得静默复用
  requestHash String?

  responseStatus Int?
  responseBody   Json?
  /// 本次执行产出的流水 id
  recordId       String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, key])
  @@index([expiresAt])
}

/// 04 §3：平台级规则模板库（不属任何 child）。
///
/// ★ 「采纳模板 = 复制而非引用」：采纳时生成 `PointRule` + `PointRuleVersion v1`，
/// 采纳后**即与模板脱钩**。否则平台改一条模板会静默改动所有家庭的规则（04 §3）。
///
/// ★ 内容量（P2 决策，用户已裁定）：**不追求 90 条**，以当前设计内容为模板开发。
model RuleTemplate {
  id   String @id @default(cuid())
  slug String @unique

  title      String
  /// 结构字段（04 §3）：'专注 25 分钟'
  condition  String
  /// 结构字段（04 §3）：2
  dailyLimit Int
  /// 恒为正（04 §4 约束：单条 ≤ 10）
  points     Int
  direction  RuleDirection

  icon  String
  color String

  ageBand    AgeBand
  focusAreas String[] @default([])

  isSystem   Boolean      @default(true)
  sortWeight Int          @default(0)
  status     RecordStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, ageBand, sortWeight])
}
